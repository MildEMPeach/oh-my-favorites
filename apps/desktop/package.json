{
  "name": "@oh-my-favorites/desktop",
  "productName": "Oh My Favorites",
  "version": "0.1.1",
  "private": true,
  "description": "Self-hosted URL inbox and favorites desktop client",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "pnpm icons && electron-vite dev",
